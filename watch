function zwatch {
	local TBAR TICKS ROSE RANCOR TIKBIN HOSTIME XTRA KEY clock VERSION OPTARG
		# Establish defaults based on behavior observed in watch from procps-ng
		# 4.0.7: 2s default, title bar, and read the top of the command output.
	declare -r VERSION='1.1.0'
	declare -F 1 TICKS=2
	declare TBAR=true
	declare RANCOR="head"

		# The help function. Adding Options as I develop them. Note: Some of
		# the options claim behavior I did not observe in procps-ng watch. I
		# have repeated the Options verbatim for familiar visual scanning.
	_zwatch_help() {
		cat <<-ZWATCHHELP >&2

			Usage:
			 ${1:t} [options] command

			Options:
			  -f, --follow           Follow the output and don't clear screen
			  -n, --interval <secs>  seconds to wait between updates
			  -t, --no-title         turn off header

			 -h, --help     display this help and exit
			 -v, --version  output version information and exit

			There are no more details yet.
		ZWATCHHELP
		}

		# As a function, I want to ensure cleanup of help and cleanup functions.
	setopt localoptions localtraps
	trap _zwatch_cleanup EXIT
	trap 'return 130' INT

	_zwatch_cleanup() {
		unfunction _zwatch_help _zwatch_cleanup
		printf '\033[?25h'
	}

	printf '\033[?25l'

	while getopts :fvhtn:-: XTRA
	do
		case ${XTRA} in
			"f")
					# -f "flips the script" and shows the end of the command output.
				RANCOR="tail"
				;;
			"v")
				printf 'zwatch %s\n' ${VERSION}
				return 0
				;;
			"t")
				TBAR=false
				;;
			"n")
					# Attempt to handle all cases of numeric input, lowest value 0.1
				! [[ ${OPTARG} == (|-)(<->(|.|.<->)|.<->) ]] && print -u2 "${0:t}: failed to parse argument: '${OPTARG}': Invalid argument" && return 1
				TICKS=$((${OPTARG}))
				[[ $TICKS -le 0 ]] && TICKS=0.1
				;;
			':')
				print -u2 -f "${0:t}: option requires an argument -- ${OPTARG}"
				_zwatch_help "$0"
				return 80
				;;
			'h')
				_zwatch_help "$0"
				return 0
				;;
			'?')
				print -u2 "${0:t}: invalid option -- ${OPTARG}"
				_zwatch_help "$0"
				return 22
				;;
			'-')
					# The cheap way of implementing long options
				case "${OPTARG}" in
					"follow")
							# --follow "flips the script" and shows the end of the command output.
						RANCOR="tail"
						;;
					"help")
						_zwatch_help "$0"
						return 0
						;;
					"version")
						printf 'zwatch %s\n' ${VERSION}
						return 0
						;;
					"interval")
							# Same as above: attempt to handle all kinds of numbers, lowest value 0.1s.
						! [[ ${*[$OPTIND]} == (|-)(<->(|.|.<->)|.<->) ]] && print -u2 "${0:t}: failed to parse argument: '${*[$OPTIND]}': Invalid argument" && return 1
						TICKS=$((${*[$OPTIND]}))
						[[ $TICKS -le 0 ]] && TICKS=0.1
						OPTIND=$((OPTIND+1))
						;;
					"no-title")
						TBAR=false
						;;
					*)
						print -u2 "${0:t}: unrecognized option \`--${OPTARG}'"
						_zwatch_help "$0"
						return 1
						;;
				esac
		esac
	done

		# sweep away the options. If there’s no command to run, complain.
	shift $((${OPTIND}-1))
	[[ ${#@} -lt 1 ]] && _zwatch_help "${0}" && return 666

		# Build static portion of title bar and initial value for screen.
	TIKBIN="Every ${TICKS}s: ${@}"
	$TBAR && ROSE=$((${LINES}-2)) || ROSE=$((${LINES}-1))

		# Do the magic!
	while () {
			printf '\033[1;1H'
				# Build the title bar
			$TBAR && { HOSTIME="$(uname -n): $(date)"
				printf "\e[30;47m%s %0$((${COLUMNS}-$((${#TIKBIN}+1))))s\e[0m\n" "${TIKBIN}" "${HOSTIME}"
				ROSE=$((${LINES}-2))
			} || ROSE=$((${LINES}-1))
			awk '{print $0 "\033[K"}' "${1}"
			printf '\033[J'
		} =("$@" 2>&1 | ${RANCOR} -$((${ROSE})) | sed -e 's/	/     /g' | cut -c-${COLUMNS})
	do
			# This looks wrong, but it needs to be this granular for the INT trap.
		for ((clock=0;clock<$((${TICKS}*10));clock++))
		do
				# wait for 0.1s for a single keypress, and exit if it’s a “q”
			if read -s -k 1 -t 0.1 KEY
			then
				[[ $KEY == q ]] && break 2
			fi
		done
	done
}
