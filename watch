	# I try to standardize on octal representations of things like tab or
	# escape, because I want this human-readable and survive copy-paste.
	# This is why zsh’s $'…' quoting is present, like $'s/\011/     /g'.

function zwatch {
	local TBAR TICKS ROSE RANCOR HOSTIME XTRA KEY clock VERSION OPTARG TIK CLIPPER COMMND
		# Establish defaults based on behavior observed in watch from procps-
		# ng 4.0.7: 2s default, title bar, and read the top of the command
		# output.
	declare -r VERSION='1.3.0'
	declare -F 1 TICKS=2
	declare TBAR=true
	declare RANCOR="head"
	declare CLIPPER='fold -w'

		# The help function. Adding Options as I develop them. Note: Some of the
		# options claim behavior I did not observe in procps-ng watch. I have
		# repeated the Options verbatim for familiar visual scanning.
	_zwatch_help() {
		cat <<-ZWATCHHELP >&2

			Usage:
			 ${1:t} [options] command

			Options:
			  -f, --follow           Follow the output and don’t clear screen
			  -n, --interval <secs>  seconds to wait between updates
			  -t, --no-title         turn off header (press ‘t’ to toggle)
			  -w, --no-wrap          turn off line wrapping (press ‘w’ to toggle)

			 -h, --help     display this help and exit
			 -v, --version  output version information and exit

			There are no more details yet.
		ZWATCHHELP
		}

		# As a function, I want to ensure cleanup of help and cleanup functions.
	setopt localoptions localtraps
	trap _zwatch_cleanup EXIT
	trap 'printf "\n"; return 130' INT

	_zwatch_cleanup() {
		unfunction _zwatch_help _zwatch_cleanup
		printf '\033[?25h'
	}

	while getopts :wfvhtn:-: XTRA
	do
		case ${XTRA} in
			"w")
				CLIPPER='cut -c-'
				;;
			"f")
					# -f “flips the script” and shows the end of the command output.
				RANCOR="tail"
				;;
			"v")
				printf 'zwatch %s\n' ${VERSION}
				return 0
				;;
			"t")
				TBAR=false
				;;
			"n")
					# Attempt to handle all cases of numeric input, lowest value 0.1
				! [[ ${OPTARG} == (|-)(<->(|.|.<->)|.<->) ]] && print -u2 "${0:t}: failed to parse argument: ‘${OPTARG}’: Invalid argument" && return 1
				TICKS=$((${OPTARG}))
				[[ $TICKS -le 0 ]] && TICKS=0.1
				;;
			':')
				print -u2 -f "${0:t}: option requires an argument -- ${OPTARG}"
				_zwatch_help "$0"
				return 80
				;;
			'h')
				_zwatch_help "$0"
				return 0
				;;
			'?')
				print -u2 "${0:t}: invalid option -- ${OPTARG}"
				_zwatch_help "$0"
				return 22
				;;
			'-')
					# The cheap way of implementing long options
				case "${OPTARG}" in
					"no-wrap")
						CLIPPER='cut -c-'
						;;
					"follow")
							# --follow “flips the script” and shows the end of the command
							# output.
						RANCOR="tail"
						;;
					"help")
						_zwatch_help "$0"
						return 0
						;;
					"version")
						printf 'zwatch %s\n' ${VERSION}
						return 0
						;;
					"interval")
							# Same as above: attempt to handle all kinds of numbers,
							# lowest value 0.1s.
						! [[ ${*[$OPTIND]} == (|-)(<->(|.|.<->)|.<->) ]] && print -u2 "${0:t}: failed to parse argument: ‘${*[$OPTIND]}’: Invalid argument" && return 1
						TICKS=$((${*[$OPTIND]}))
						[[ $TICKS -le 0 ]] && TICKS=0.1
						OPTIND=$((OPTIND+1))
						;;
					"no-title")
						TBAR=false
						;;
					*)
						print -u2 "${0:t}: unrecognized option ‘--${OPTARG}’"
						_zwatch_help "$0"
						return 1
						;;
				esac
		esac
	done

		# Sweep away the options. If there’s no command to run, complain.
	shift $((${OPTIND}-1))
	local FULLCMD="$*"

	[[ -z ${FULLCMD} ]] && _zwatch_help "${0}" && return 666

		# Hide the cursor… this matters.
	printf '\033[?25l'

		# Build static portion of title bar and initial value for screen.
	TIK="Every ${TICKS}s: "
	$TBAR && ROSE=$((${LINES}-1)) || ROSE=${LINES}

		# Do the magic!
	while
		HOSTIME="$(uname -n): $(date)"
		printf '\033[1;1H'
	do
		() {
				# This looks wrong, but it needed to be this granular for the INT
				# trap, then I just decided to use it for other things.
			for ((clock=0;clock<$((${TICKS}*10));clock++))
			do
					# Build the title bar
				$TBAR && {
					local REMAIN=$((${COLUMNS}-(${(m)#HOSTIME}+${(m)#TIK}+2)))
					[[ ${REMAIN} -lt 1 ]] && REMAIN=1
					[[ ${(m)#FULLCMD} -gt ${REMAIN} ]] &&
						COMMND="${(mr:$((${REMAIN}-1)):)FULLCMD}…" ||
						COMMND="${(mr:${REMAIN}:)FULLCMD}"
					printf '\033[1;1H\033[30;47m%s%s  %s\033[0m' "${TIK}" "${COMMND}" "${HOSTIME}"
					ROSE=$((${LINES}-1))
				} || ROSE=${LINES}
				$TBAR && printf '\033[2;1H' || printf '\033[1;1H'
				sed -e $'s/\011/     /g' "${1}" |
				${=CLIPPER}${COLUMNS} |
				${RANCOR} -${ROSE} |
				awk -v lines="${LINES}" -v title="${TBAR}" -v cols="${COLUMNS}" 'NR>1 {printf "\n"} {printf "%s%s", $0, (length($0) < cols ? "\033[K" : "")} END { nextrow = NR + (title == "true" ? 2 : 1); if (nextrow <= lines) printf "\033[%d;1H\033[J", nextrow}'

					# wait for 0.1s for a single keypress…
				if read -s -k 1 -t 0.1 KEY
				then
					case ${KEY} in
							# … and exit if it’s a “q”
						"q")
							printf '\n'
							break 2
							;;
							# … and since we’re doing keystrokes now, toggles are possible
						"t")
							case ${TBAR} in
								true) TBAR=false ;;
								false) TBAR=true ;;
							esac
							;;
						"w")
							case "${CLIPPER}" in
								'cut -c-')
									CLIPPER='fold -w'
									;;
								'fold -w')
									CLIPPER='cut -c-'
									;;
							esac
							;;
					esac
				fi
			done
		} =( "$@" 2>&1 )
	done
}
