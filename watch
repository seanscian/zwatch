function zwatch {
	local TBAR TICKS ROSE
	declare -F 1 TICKS=2
	declare TBAR=true

	_help() {
		print -u2 -f "\nUsage:\n ${1:t} [options] command\n\nOptions:\n  -n, --interval <secs>  seconds to wait between updates\n  -t, --no-title         turn off header\n\n -h, --help     display this help and exit\n -v, --version  output version information and exit\n\nThere are no more details yet.\n"
	}

	while getopts :vhtn:-: XTRA
	do
		case ${XTRA} in
			"v")
				print 'watch in zsh 1.0.1'
				exit 0
				;;
			"t")
				TBAR=false
				;;
			"n")
				! [[ ${OPTARG} == (|-)(<->(|.|.<->)|.<->) ]] && print -u2 "${0:t}: failed to parse argument: '${OPTARG}': Invalid argument" && exit 1
				TICKS=$((${OPTARG}))
				[[ $TICKS -le 0 ]] && TICKS=0.1
				;;
			':')
				print -u2 -f "${0:t}: option requires an argument -- ${OPTARG}"
				_help "$0"
				exit 80
				;;
			'h')
				_help "$0"
				exit 0
				;;
			'?')
				print -u2 "${0:t}: invalid option -- ${OPTARG}"
				_help "$0"
				exit 22
				;;
			'-')
				case "${OPTARG}" in
					"help")
						_help "$0"
						exit 0
						;;
					"version")
						print 'watch in zsh 1.0.1'
						exit 0
						;;
					"interval")
						! [[ ${*[$OPTIND]} == (|-)(<->(|.|.<->)|.<->) ]] && print -u2 "${0:t}: failed to parse argument: '${*[$OPTIND]}': Invalid argument" && exit 1
						TICKS=$((${*[$OPTIND]}))
						[[ $TICKS -le 0 ]] && TICKS=0.1
						OPTIND=$((OPTIND+1))
						;;
					"no-title")
						TBAR=false
						;;
					*)
						print -u2 "${0:t}: unrecognized option \`--${OPTARG}'"
						_help "$0"
						exit 1
						;;
				esac
		esac
	done

	shift $((${OPTIND}-1))
	[[ ${#@} -lt 1 ]] && _help "${0}" && exit 666

	header_loop() {
		TIKBIN="Every ${TICKS}s: ${@}"
		HOSTIME="$(uname -n): $(date)"
		printf "\e[30;47m%s %0$((${COLUMNS}-$((${#TIKBIN}+1))))s\e[0m\n" "${TIKBIN}" "${HOSTIME}"
	}

	$TBAR && ROSE=$((${LINES}-2)) || ROSE=$((${LINES}-1))

	while () {
			clear
			$TBAR && header_loop "${@:2}"
			$TBAR && ROSE=$((${LINES}-2)) || ROSE=$((${LINES}-1))
			cat -- "${1}"
		} =("$@" | head -$((${ROSE})) | sed -e 's/	/     /g' | cut -c-${COLUMNS}) "$@"
	do
		if read -s -k 1 -t ${TICKS} KEY
		then
			[[ $KEY == q ]] && break
		fi
	done
}
